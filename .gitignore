# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Local environment files
.env
.env.*
# Python cache files
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
venv/
.venv/
